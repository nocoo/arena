{
  "name": "arena",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "dev": "bun run --cwd packages/web dev",
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/cli && tsc --noEmit -p packages/web"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "unrs-resolver"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.3.12",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "picomatch": "^4.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  }
}
